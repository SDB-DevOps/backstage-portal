{
  "name": "backstage-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "18 || 20"
  },
  "scripts": {
    "dev": "concurrently \"yarn start\" \"yarn start-backend\"",
    "start": "yarn --cwd packages/app start",
    "start-backend": "yarn --cwd packages/backend start",
    "build:backend": "yarn --cwd packages/backend build",
    "build:all": "backstage-cli repo build --all",
    "build:image": "docker build -t ghcr.io/sdb-devops/backstage-portal:latest .",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "lint": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "new": "backstage-cli new --scope sdb"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.26.0",
    "@spotify/prettier-config": "^15.0.0",
    "concurrently": "^8.2.2",
    "lerna": "^7.3.0",
    "node-gyp": "^10.0.1",
    "prettier": "^3.2.5",
    "typescript": "~5.3.3"
  },
  "resolutions": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "packageManager": "yarn@1.22.22"
}
